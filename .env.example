# Vercel 환경변수 예시 (.env.example — 실제 배포에는 Vercel Settings → Environment Variables 에 입력)
# 이 파일은 참고용이며 저장소에 키를 실제로 적어 두지 않습니다.

# 필수
ANTHROPIC_API_KEY=

# 권장: 앱의 ⚙ 설정 → API 접근 코드 에 같은 값을 입력해야 생성이 됩니다.
APP_ACCESS_CODE=

# 선택: 추가로 허용할 오리진 (쉼표 구분). 같은 오리진과 localhost 는 자동 허용.
APP_ALLOWED_ORIGINS=

# 선택: 모델 / 응답 토큰 / 입력 길이
APP_MODEL=claude-sonnet-5-5
APP_MAX_TOKENS=1200
MAX_PROMPT_CHARS=8000

# 선택: 요청 속도 제한 (IP당 분당·일일, 전체 일일)
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=200
RATE_LIMIT_GLOBAL_PER_DAY=500
